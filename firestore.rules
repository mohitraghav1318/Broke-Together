rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isNotebookMember(notebook) {
      return signedIn() && request.auth.uid in notebook.data.memberIds;
    }

    function isNotebookMemberById(notebookId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/notebooks/$(notebookId)).data.memberIds;
    }

    function isJoiningSelf() {
      return signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly([
          "name",
          "ownerUid",
          "memberIds",
          "friends",
          "createdAt",
          "updatedAt"
        ]);
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /notebooks/{notebookId} {
      allow get: if signedIn();
      allow list: if isNotebookMember(resource);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.keys().hasOnly([
          "name",
          "ownerUid",
          "memberIds",
          "friends",
          "createdAt",
          "updatedAt"
        ]);
      allow update: if isNotebookMember(resource) || isJoiningSelf();
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /entries/{entryId} {
        allow read: if isNotebookMemberById(notebookId);
        allow create: if isNotebookMemberById(notebookId)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.keys().hasOnly([
            "amount",
            "paidByFriendId",
            "splitFriendIds",
            "category",
            "description",
            "createdByUid",
            "createdByName",
            "createdAt"
          ]);
        allow update, delete: if false;
      }
    }
  }
}
